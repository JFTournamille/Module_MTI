# ─── Base de données ────────────────────────────────────────────────────────
# En production CapRover, l'hôte est le nom interne du service de la one-click
# app PostgreSQL (srv-captain--mti-db). Utiliser le rôle applicatif mti_app,
# pas postgres : c'est lui qui n'a pas le droit d'altérer le journal d'audit.
DATABASE_URL=postgresql://mti_app:MOT_DE_PASSE@srv-captain--mti-db:5432/mti

# ─── Authentification ───────────────────────────────────────────────────────
# dev  : opérateur fixe, pour le développement. REFUSÉ si NODE_ENV=production.
# oidc : SSO de l'établissement — à brancher avant toute mise en service.
AUTH_MODE=dev
NODE_ENV=development

# Uniquement en AUTH_MODE=dev. L'opérateur est résolu par son identifiant,
# pas par son UUID : rien à recopier depuis la base.
DEV_UTILISATEUR_IDENTIFIANT=mdurand

# ─── Discrétion (phase de test avec des testeurs externes) ──────────────────
# DISCRETION=oui masque ce qui renseigne sur la mécanique : le message brut de
# PostgreSQL, la signature du cadriciel dans une 404, et le détail de
# /api/sante. Séparé de NODE_ENV à dessein : l'instance de démonstration
# tourne en AUTH_MODE=dev, donc en NODE_ENV=development, et lier la discrétion
# à NODE_ENV l'aurait rendue inopérante précisément là où elle sert.
# Actif d'office quand NODE_ENV=production.
DISCRETION=non

# Rend le détail de /api/sante à qui connaît le jeton :
#   /api/sante?detail=<JETON>
# Sans jeton renseigné, le détail n'est plus accessible du tout quand
# DISCRETION est actif — l'état sommaire (statut, base joignable, migrations)
# reste public, c'est ce qui permet de vérifier un déploiement.
DIAGNOSTIC_JETON=

# ─── Divers ─────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
DB_POOL_MAX=10

# Mot de passe Postgres pour docker-compose en local.
POSTGRES_PASSWORD=mti_dev
